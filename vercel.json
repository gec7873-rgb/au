{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },

    { "source": "/au", "destination": "/au/index.html" },
    { "source": "/au/", "destination": "/au/index.html" },
    { "source": "/login", "destination": "/au/login.html" },
    { "source": "/au/apply", "destination": "/au/apply.html" },

    { "source": "/css/index.css", "destination": "/au/css/index.css" },
    { "source": "/css/login.css", "destination": "/au/css/login.css" },
    { "source": "/css/apply.css", "destination": "/au/css/apply.css" },

    { "source": "/js/index.js", "destination": "/au/js/index.js" },
    { "source": "/js/login.js", "destination": "/au/js/login.js" },
    { "source": "/js/apply.js", "destination": "/au/js/apply.js" },

    { "source": "/au/(.*)", "destination": "/au/$1" },
    { "source": "/(.*)", "destination": "/404.html" }
  ],
  "headers": [
    {
      "source": "/au/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "no-referrer-when-downgrade" }
      ]
    }
  ]
}
